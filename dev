#!/bin/sh
# Execute this file; do not source it. All environment changes are process-local.
set -eu

repo_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
cd "$repo_dir"

# rust-toolchain.toml is the single source of the compiler version pin.
toolchain=$(sed -n 's/^channel = "\([^"]*\)"$/\1/p' rust-toolchain.toml)
if [ -z "$toolchain" ]; then
    echo "error: missing channel in rust-toolchain.toml" >&2
    exit 1
fi

export RUSTUP_HOME="$repo_dir/.dev/rustup"
export CARGO_HOME="$repo_dir/.dev/cargo"
export CARGO_INSTALL_ROOT="$CARGO_HOME"
export CARGO_TARGET_DIR="$repo_dir/target"
export CARGO_BUILD_BUILD_DIR="$CARGO_TARGET_DIR"
export RUSTUP_TOOLCHAIN="$toolchain"
export PATH="$CARGO_HOME/bin:${PATH:-/usr/bin:/bin}"
export TMPDIR="$repo_dir/.dev/tmp"
export XDG_CACHE_HOME="$repo_dir/.dev/cache"

# Prevent inherited compiler/tool overrides from selecting a global installation
# or putting wrapper caches outside the repository.
export RUSTC="$CARGO_HOME/bin/rustc"
export RUSTDOC="$CARGO_HOME/bin/rustdoc"
export RUSTFMT="$CARGO_HOME/bin/rustfmt"
export RUSTC_WRAPPER=""
export RUSTC_WORKSPACE_WRAPPER=""
export CARGO_BUILD_RUSTC_WRAPPER=""
export CARGO_BUILD_RUSTC_WORKSPACE_WRAPPER=""
unset CLIPPY_DRIVER_PATH

# CI opts in explicitly; ordinary local runs collect independent test failures.
test_fail_fast=${TWIGSMITH_DEV_FAIL_FAST:-0}
case "$test_fail_fast" in
    0) cargo_failure_mode=--no-fail-fast ;;
    1) cargo_failure_mode='' ;;
    *) echo 'error: TWIGSMITH_DEV_FAIL_FAST must be 0 or 1' >&2; exit 2 ;;
esac

usage() {
    cat <<'EOF'
Usage: ./dev COMMAND [ARGS]

  bootstrap       Install the pinned Rust toolchain, rustfmt, and Clippy locally
  build [ARGS]    Build both native executables (pass --release for optimization)
  test [ARGS]     Run the Rust tests and CLI smoke checks
  package-native OUTPUT [--allow-dirty] [--target x86_64-unknown-linux-gnu]
                  Build an isolated optimized native archive and provenance files
  verify-native ARCHIVE [--extract-to DIR]
                  Verify native archive integrity and optionally extract it
  package-npm ARCHIVE OUTPUT --archive-sha256 HASH --payload-sha256 HASH
                  Package a verified native candidate for npm
  test-packaging  Run native and npm packaging format and failure regression checks
  native-qualify [ARGS]
                  Run extracted-artifact workflow/runtime qualification
  test-shells [--require-all]
                  Run native shell tests available on this host
  test-groups     List focused test groups and their Cargo targets
  test-group NAME [ARGS]
                  Run a focused group, forwarding ARGS to Cargo test
  fmt [ARGS]      Format Rust source (pass --check to verify without changes)
  lint [ARGS]     Run Clippy on all targets with warnings treated as errors
  check           Verify formatting, build, tests, and linting
  cargo [ARGS]    Invoke repository-local Cargo (e.g. cargo run -- --help)
  rustc [ARGS]    Invoke the pinned repository-local compiler
  help            Show these development commands

Set TWIGSMITH_DEV_FAIL_FAST=1 to stop full and native-shell runs after a failed stage.
EOF
}

# Keep discovery and execution on the same target definitions. Groups are
# conveniences; full runs use the separate ordered sequence below.
test_group() {
    case "$1" in
        start)
            group_description='Start planning, execution, and command interaction'
            group_targets='start_resolution start_workflow cli_start remote_roles'
            ;;
        save)
            group_description='Save planning, checkpoints, publication, and command interaction'
            group_targets='save_planning save_execution save_publication cli_save remote_roles'
            ;;
        finish)
            group_description='Finish planning, preparation, publication, recovery, and command interaction'
            group_targets='finish_integration finish_planning finish_preparation finish_publication finish_roles finish_checks cli_finish cli_history cli_history_presentation'
            ;;
        config)
            group_description='Settings, setup, and cross-command finish-check configuration'
            group_targets='settings cli_config finish_checks'
            ;;
        status)
            group_description='Repository observation and status presentation'
            group_targets='repository_state cli_status'
            ;;
        shared)
            group_description='Development launcher, Git boundary, observation, settings, tracking, roles, and exact publication'
            group_targets='dev_selection native_packaging bash_completion git_execution cli_activity repository_state settings remote_roles finish_roles finish_checks save_publication finish_publication'
            ;;
        lifecycle)
            group_description='CLI smoke and end-to-end project/fork lifecycles'
            group_targets='cli_smoke cli_lifecycle cli_oneflow cli_direct_sequence cli_hosted_oneflow cli_hosted_recovery cli_hosted_presentation cli_history cli_history_presentation'
            ;;
        smoke)
            group_description='CLI smoke checks and development launcher selection'
            group_targets='cli_smoke dev_selection bash_completion'
            ;;
        completion)
            group_description='Repository completion, shell insertion, and user registration'
            group_targets='bash_completion completion_engine completion_setup completion_shells'
            ;;
        history-edit)
            group_description='Ordinary interactive history preparation and native recovery'
            group_targets='finish_preparation cli_history cli_history_presentation'
            ;;
        finish-planning)
            group_description='Review finish planning and eligibility'
            group_targets='finish_planning'
            ;;
        oneflow)
            group_description='Direct OneFlow release and hotfix command lifecycles'
            group_targets='cli_oneflow cli_direct_sequence'
            ;;
        hosted-oneflow)
            group_description='Hosted OneFlow version and merge-back preparation and recovery'
            group_targets='cli_hosted_oneflow cli_hosted_recovery cli_hosted_presentation'
            ;;
        *)
            echo "error: unknown test group '$1'; use ./dev test-groups to list groups" >&2
            exit 2
            ;;
    esac
}

# Record failures without hiding command output. CI stops before later stages.
failed_tests=''
run_test() {
    test_label=$1
    shift
    if "$@"; then
        :
    else
        test_status=$?
        failed_tests="${failed_tests}
  $test_label (exit $test_status)"
        if [ "$test_fail_fast" = 1 ]; then
            finish_tests || exit 1
        fi
    fi
}

finish_tests() {
    if [ -n "$failed_tests" ]; then
        printf '\nFAILED test stages:%s\n' "$failed_tests" >&2
        return 1
    fi
}

# Cargo sorts selected targets itself, so invoke suites separately to establish
# lifecycle order. Keep new conventional auto-discovered suites in the full run
# even before they receive a position in this preferred sequence.
full_tests() {
    # Match Cargo's ordinary compilation coverage, including examples, before
    # starting tests. A compilation failure prevents meaningful test execution.
    "$cargo" test --locked --no-run
    ordered_targets='
        cli_smoke cli_activity
        settings cli_config
        @units dev_selection native_packaging git_execution repository_state remote_roles cli_status
        bash_completion completion_engine completion_setup completion_shells native_completion
        start_resolution start_workflow cli_start
        save_planning save_execution save_publication cli_save
        finish_planning finish_checks finish_roles finish_preparation
        finish_integration finish_publication cli_finish cli_history cli_history_presentation
        cli_lifecycle cli_oneflow cli_direct_sequence
        cli_hosted_oneflow cli_hosted_presentation cli_hosted_recovery'
    executed_targets=' '
    for full_target in $ordered_targets; do
        if [ "$full_target" = @units ]; then
            run_test 'library and binary unit tests' "$cargo" test --locked ${cargo_failure_mode:+"$cargo_failure_mode"} --lib --bins
        elif [ -f "tests/$full_target.rs" ] || [ -f "tests/$full_target/main.rs" ]; then
            run_test "$full_target" "$cargo" test --locked ${cargo_failure_mode:+"$cargo_failure_mode"} --test "$full_target"
            executed_targets="$executed_targets$full_target "
        fi
    done
    # Cargo's conventional integration layouts. Explicit manifest targets with
    # other paths need to be added to this discovery when introduced.
    for full_path in tests/*.rs tests/*/main.rs; do
        [ -f "$full_path" ] || continue
        full_target=${full_path#tests/}
        full_target=${full_target%/main.rs}
        full_target=${full_target%.rs}
        case "$executed_targets" in
            *" $full_target "*) continue ;;
        esac
        run_test "$full_target" "$cargo" test --locked ${cargo_failure_mode:+"$cargo_failure_mode"} --test "$full_target"
        executed_targets="$executed_targets$full_target "
    done
    run_test doctests "$cargo" test --locked ${cargo_failure_mode:+"$cargo_failure_mode"} --doc
    test_shells
    finish_tests
}

# Ordinary tests show external-runtime cases as ignored. Select those cases only
# after checking the host and executable; missing local runtimes are unavailable,
# never successful test executions. CI requires its provisioned runtime set.
test_shells() {
    shell_requirement=${1:-available}
    case "$(uname -s)" in
        Linux) shell_targets='completion_shells completion_setup'; shell_names='fish zsh pwsh' ;;
        Darwin) shell_targets='native_completion'; shell_names='bash fish zsh' ;;
        *) echo 'Native shell tests unavailable through this Unix launcher on this host.' >&2; return 0 ;;
    esac
    missing_shells=''
    for shell_name in $shell_names; do
        case "$shell_name" in
            bash) shell_path=${TWIGSMITH_TEST_BASH:-$(command -v bash || true)} ;;
            fish) shell_path=${TWIGSMITH_TEST_FISH:-$(command -v fish || true)} ;;
            zsh) shell_path=${TWIGSMITH_TEST_ZSH:-$(command -v zsh || true)} ;;
            pwsh) shell_path=${TWIGSMITH_TEST_PWSH:-$(command -v pwsh || true)} ;;
        esac
        shell_ready=false
        if [ -x "$shell_path" ]; then
            if [ "$shell_name" = pwsh ]; then
                if "$shell_path" -NoLogo -NoProfile -NonInteractive -Command 'if ($PSVersionTable.PSVersion -ge [version]"7.3") { exit 0 } else { exit 1 }' >/dev/null 2>&1; then
                    shell_ready=true
                fi
            elif "$shell_path" --version >/dev/null 2>&1; then
                shell_ready=true
            fi
        fi
        if [ "$shell_ready" = false ]; then
            missing_shells="$missing_shells $shell_name"
        fi
    done
    if [ "$shell_requirement" = required ] && [ -n "$missing_shells" ]; then
        echo "error: native test environment is incomplete; unavailable or unsupported:$missing_shells (tests not started)" >&2
        return 1
    fi
    for shell_name in $shell_names; do
        case " $missing_shells " in
            *" $shell_name "*) echo "SKIPPED native $shell_name tests: runtime unavailable or unsupported" >&2; continue ;;
        esac
        shell_filter=$shell_name
        [ "$shell_name" != pwsh ] || shell_filter=powershell
        set -- test --locked ${cargo_failure_mode:+"$cargo_failure_mode"}
        for shell_target in $shell_targets; do
            set -- "$@" --test "$shell_target"
        done
        run_test "native $shell_name" "$cargo" "$@" "$shell_filter" -- --ignored --nocapture
    done
}

run_shells_after_test=false
command=${1:-help}
if [ "$#" -gt 0 ]; then shift; fi
case "$command" in
    help|-h|--help) usage; exit 0 ;;
    test-groups)
        if [ "$#" -ne 0 ]; then
            echo 'error: usage: ./dev test-groups' >&2
            exit 2
        fi
        echo 'Every group includes --lib --bins and the following --test targets:'
        for group in start save finish config status shared lifecycle smoke completion finish-planning history-edit oneflow hosted-oneflow; do
            test_group "$group"
            printf '\n%s: %s\n  %s\n' "$group" "$group_description" "$group_targets"
        done
        exit 0
        ;;
    test-group)
        if [ "$#" -eq 0 ]; then
            echo 'error: usage: ./dev test-group NAME [CARGO_TEST_ARGS]; use ./dev test-groups to list groups' >&2
            exit 2
        fi
        if [ "$1" = completion ] && [ "$#" -eq 1 ]; then run_shells_after_test=true; fi
        test_group "$1"
        shift
        # Split only our fixed target list. Preserve every caller argument,
        # including test-name filters and the test-harness -- boundary.
        for target in $group_targets; do
            set -- --test "$target" "$@"
        done
        set -- --lib --bins "$@"
        command=test
        ;;
    test-shells)
        case "$*" in
            '') shell_requirement=available ;;
            --require-all) shell_requirement=required ;;
            *) echo 'error: usage: ./dev test-shells [--require-all]' >&2; exit 2 ;;
        esac
        ;;
    package-native) exec python3 "$repo_dir/tools/native_package.py" build "$@" ;;
    verify-native) exec python3 "$repo_dir/tools/native_package.py" verify "$@" ;;
    package-npm) exec python3 "$repo_dir/tools/npm_package.py" "$@" ;;
    test-packaging)
        python3 -m unittest discover -s "$repo_dir/tools" -p 'test_*native*.py' "$@"
        python3 -m unittest discover -s "$repo_dir/tools" -p 'test_npm_package.py' "$@"
        python3 -m unittest discover -s "$repo_dir/tools" -p 'test_release_set.py' "$@"
        python3 -m unittest discover -s "$repo_dir/tools" -p 'test_release_recovery.py' "$@"
        python3 -m unittest discover -s "$repo_dir/tools" -p 'test_release_stage.py' "$@"
        python3 -m unittest discover -s "$repo_dir/tools" -p 'test_release_publish.py' "$@"
        exec python3 -m unittest discover -s "$repo_dir/site" -p 'test_*.py' "$@"
        ;;
    native-qualify) exec python3 "$repo_dir/tools/qualify_native.py" "$@" ;;
    bootstrap|build|test|fmt|lint|check|cargo|rustc) ;;
    *) usage >&2; exit 2 ;;
esac

mkdir -p "$TMPDIR" "$XDG_CACHE_HOME"
rustup="$CARGO_HOME/bin/rustup"
cargo="$CARGO_HOME/bin/cargo"

if [ "$command" = bootstrap ]; then
    for prerequisite in curl cc; do
        if ! command -v "$prerequisite" >/dev/null 2>&1; then
            echo "error: bootstrap requires $prerequisite (cc must be a C compiler/linker driver with system headers and libc development files)" >&2
            exit 1
        fi
    done
    if [ ! -x "$rustup" ]; then
        curl --proto '=https' --tlsv1.2 --fail --show-error --location \
            https://sh.rustup.rs --output "$TMPDIR/rustup-init.sh"
        # Rustup's installer may coexist with a global Rust installation, but
        # never uses it. --no-modify-path leaves shell profiles untouched.
        RUSTUP_INIT_SKIP_PATH_CHECK=yes sh "$TMPDIR/rustup-init.sh" \
            -y --no-modify-path --profile minimal --default-toolchain none
        rm -f "$TMPDIR/rustup-init.sh"
    fi
    "$rustup" set auto-self-update disable
    "$rustup" toolchain install "$toolchain" --profile minimal \
        --component rustfmt --component clippy --no-self-update
    "$CARGO_HOME/bin/rustc" --version
    "$cargo" --version
    exit 0
fi

if [ ! -x "$rustup" ]; then
    echo "error: repository-local Rust is missing; run ./dev bootstrap first" >&2
    exit 1
fi

case "$command" in
    build) exec "$cargo" build --locked "$@" ;;
    test)
        if [ "$#" -gt 0 ] && [ "$run_shells_after_test" = false ]; then exec "$cargo" test --locked "$@"; fi
        if [ "$#" -eq 0 ]; then
            full_tests
        else
            run_test "regular suite" "$cargo" test --locked ${cargo_failure_mode:+"$cargo_failure_mode"} "$@"
            test_shells
            finish_tests
        fi
        ;;
    test-shells)
        test_shells "$shell_requirement"
        finish_tests
        ;;
    fmt) exec "$cargo" fmt --all "$@" ;;
    lint) exec "$cargo" clippy --locked --all-targets "$@" -- -D warnings ;;
    check)
        "$cargo" fmt --all --check
        "$cargo" build --locked
        "$cargo" clippy --locked --all-targets -- -D warnings
        full_tests
        ;;
    cargo) exec "$cargo" "$@" ;;
    rustc) exec "$CARGO_HOME/bin/rustc" "$@" ;;
esac
